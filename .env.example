# Optional. Copy to .env to override defaults; `docker-compose up` works without it.

# Port the app is served on: http://localhost:8080
WEB_PORT=8080

# Database (internal to Docker; not exposed to the host)
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund_demo_password
POSTGRES_DB=refund_support

# The API and the migrate service build their DATABASE_URL from these values.

# Signs customer session cookies (at least 32 characters). Leave empty to use a random
# secret generated at startup; customers then need to sign in again after a restart.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Bearer token for the support dashboard (at least 12 characters). Leave empty to use the
# public demo token "admin-demo-token"; the API logs a warning when it does.
ADMIN_TOKEN=

# AI provider. Only LLM_API_KEY is needed; the provider is detected from the key prefix:
#   sk-ant-  Anthropic       sk-or-  OpenRouter      gsk_  Groq
#   AIza or AQ.  Google Gemini   sk-  OpenAI
# Leave empty to run with AI disabled: the policy still decides, and refunds it would
# approve are sent to a reviewer instead.
LLM_API_KEY=

# Optional overrides. LLM_BASE_URL selects any OpenAI-compatible API (DeepSeek, Mistral,
# Ollama at http://host.docker.internal:11434/v1) and then requires LLM_MODEL.
# LLM_PROVIDER: anthropic | openai | gemini | groq | openrouter | openai-compatible
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=

# Anthropic only: an organization-level key (not created inside a workspace) is rejected
# unless it names a workspace. Copy the ID (wrkspc_…) from the Anthropic Console.
ANTHROPIC_WORKSPACE_ID=

# Time limit for one AI call, in milliseconds (1000 to 120000).
AI_TIMEOUT_MS=20000
# Minimum self-reported model confidence (0 to 1) for an automatic approval. Lower values
# never approve anything the policy would not; they only reduce escalations.
AI_MIN_CONFIDENCE=0.95
