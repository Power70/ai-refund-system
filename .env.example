# Optional. Copy to .env to override defaults; `docker-compose up` works without it.

# Port the app is served on: http://localhost:8080
WEB_PORT=8080

# Database (internal to Docker; not exposed to the host)
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund_demo_password
POSTGRES_DB=refund_support

# The LLM API key and app secrets are added in later build steps.
