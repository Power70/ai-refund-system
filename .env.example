# Optional. Copy to .env to override defaults; `docker-compose up` works without it.

# Port the app is served on: http://localhost:8080
WEB_PORT=8080

# Database (internal to Docker; not exposed to the host)
POSTGRES_USER=refund
POSTGRES_PASSWORD=refund_demo_password
POSTGRES_DB=refund_support

# The API and the migrate service build their DATABASE_URL from these values.

# Signs customer session cookies (at least 32 characters). Leave empty to use a random
# secret generated at startup; customers then need to sign in again after a restart.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Bearer token for the support dashboard (at least 12 characters). Leave empty to use the
# public demo token "admin-demo-token"; the API logs a warning when it does.
ADMIN_TOKEN=

# The LLM API key is added in a later build step.
